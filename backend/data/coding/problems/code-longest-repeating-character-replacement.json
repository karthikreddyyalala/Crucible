  "compare": "exact",
  "referenceSolution": "from collections import Counter\n\n\ndef character_replacement(s: str, k: int) -> int:\n    counts = Counter()\n    left = most = 0\n    for right, ch in enumerate(s):\n        counts[ch] += 1\n        most = max(most, counts[ch])\n        if right - left + 1 - most > k:\n            counts[s[left]] -= 1\n            left += 1\n    return len(s) - left\n",
  "targetComplexity": {"time": "O(n)", "space": "O(1)"},
