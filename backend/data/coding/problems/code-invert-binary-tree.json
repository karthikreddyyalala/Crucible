{
  "id": "code-invert-binary-tree",
  "title": "Invert Binary Tree",
  "difficulty": "easy",
  "topics": ["tree", "depth-first search", "breadth-first search"],
  "asked": "very_common",
  "statement": "You're given the root of a binary tree. Mirror it: at every node, swap the left and right children. Return the root of the mirrored tree.\n\nYou may change the tree in place or build a new one. The tree may be empty (`None`). Each node is a `TreeNode` with `val`, `left` and `right`; the class is already defined for you. In the examples, a tree is written in level order with `null` for a missing child.\n\nConstraints: 0 to 2000 nodes; -100 <= val <= 100.",
  "functionName": "invert_tree",
  "signature": "def invert_tree(root: Optional[TreeNode]) -> Optional[TreeNode]:",
  "starterCode": "def invert_tree(root: Optional[TreeNode]) -> Optional[TreeNode]:\n    \"\"\"Return the root of the mirror image of the tree.\"\"\"\n    pass\n",
  "starterCodeJs": "// TreeNode is provided: new TreeNode(val, left, right) -> { val, left, right }\n\n/**\n * Return the root of the mirror image of the tree.\n * @param {TreeNode|null} root\n * @return {TreeNode|null}\n */\nfunction invertTree(root) {\n\n}\n",
  "examples": [
    {"input": "root = [5, 3, 8, 1, 4, 7, 9]", "output": "[5, 8, 3, 9, 7, 4, 1]", "explanation": "Every left/right pair trades places, at every level."},
    {"input": "root = [1, 2]", "output": "[1, null, 2]", "explanation": "The only child moves from the left side to the right side."},
    {"input": "root = []", "output": "[]", "explanation": "An empty tree stays empty."}
  ],
