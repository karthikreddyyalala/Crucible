  "idealAnswerPoints": [
    "Swaps left and right at every node, recursively or with a stack or queue",
    "Swaps both children in one step so neither subtree is lost",
    "Returns the root, including None for an empty tree",
    "States O(n) time and O(h) space and mentions the iterative alternative"
  ],
  "weakAnswerSigns": [
    "Overwrites one child before saving it and loses a subtree",
    "Swaps only the root's children and stops",
    "Forgets to return the root, or returns None for a non-empty tree"
