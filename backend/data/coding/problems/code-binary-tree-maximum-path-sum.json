  "compare": "exact",
  "adapters": {"root": "tree"},
  "referenceSolution": "def max_path_sum(root: Optional[TreeNode]) -> int:\n    best = root.val\n\n    def gain(node):\n        nonlocal best\n        if node is None:\n            return 0\n        left = max(gain(node.left), 0)\n        right = max(gain(node.right), 0)\n        best = max(best, node.val + left + right)\n        return node.val + max(left, right)\n\n    gain(root)\n    return best\n",
  "targetComplexity": {"time": "O(n)", "space": "O(h), h = height of the tree"},
  "hints": [
    "Every path has one highest node, where it may bend. If you fix that node, what does the best path through it look like?",
    "At a node, the best bending path uses the best downward chain from each child. What should one recursive call hand back to its parent?",
    "A parent can extend only one downward chain, not a path that already bends. Keep 'best chain to return' separate from 'best path seen anywhere'.",
    "What if a child's best chain is negative, as in `[2, -1, 3]`? And what if every value is negative, as in `[-2, -1, -3]`?",
    "Post-order DFS: gain(node) = node.val + max(0, gain(left), gain(right)), and update a running best with node.val + max(0, gain(left)) + max(0, gain(right))."
  ],
  "followUps": [
    "Why does your helper return a different value from the one it uses to update the answer?",
    "What happens if you start the answer at 0 instead of a node's value, and which input exposes it?",
    "What are the time and space costs, and how would you avoid deep recursion on a chain of 3 * 10^4 nodes?",
    "How would you also return the nodes on the best path, not just its sum?"
  ],
  "idealAnswerPoints": [
    "Separates the downward gain returned to the parent from the bending path used to update the answer",
    "Drops negative child gains with max(0, ...)",
    "Starts the answer from a real node value so all-negative trees work",
    "Does one post-order pass: O(n) time and O(h) space"
  ],
  "weakAnswerSigns": [
    "Returns the bending path sum to the parent, letting a path fork",
    "Starts the answer at 0 and returns 0 for an all-negative tree",
    "Only considers paths that pass through the root",
    "Recomputes subtree sums at every node for O(n^2) time"
  ],
  "rubric": {
    "correctness": "Right sum for all-negative trees, single nodes, paths that avoid the root and paths that bend deep in a subtree.",
    "efficiency": "One post-order traversal: O(n) time and O(h) extra space.",
    "code_quality": "A small helper that returns the downward gain and updates the best total, with no module-level state carried between calls.",
    "communication": "Explains the difference between 'path that bends here' and 'chain I can hand to my parent' before coding, and tests an all-negative tree."
  }
