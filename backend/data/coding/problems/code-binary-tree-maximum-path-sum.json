{
  "id": "code-binary-tree-maximum-path-sum",
  "title": "Binary Tree Maximum Path Sum",
  "difficulty": "hard",
  "topics": ["tree", "depth-first search", "dynamic programming"],
  "asked": "very_common",
  "statement": "You're given the root of a non-empty binary tree whose values can be negative. A path is a chain of nodes where each consecutive pair is joined by an edge (parent to child or child to parent) and no node appears twice. A path has at least one node and doesn't have to pass through the root.\n\nReturn the largest sum of node values over all paths in the tree. Each node is a `TreeNode` with `val`, `left` and `right`; the class is already defined for you. In the examples, a tree is written in level order with `null` for a missing child.\n\nConstraints: 1 to 3 * 10^4 nodes; -1000 <= val <= 1000.",
  "functionName": "max_path_sum",
  "signature": "def max_path_sum(root: Optional[TreeNode]) -> int:",
  "starterCode": "def max_path_sum(root: Optional[TreeNode]) -> int:\n    \"\"\"Return the largest sum over all paths in the tree.\"\"\"\n    pass\n",
  "examples": [
    {"input": "root = [2, -1, 3]", "output": "5", "explanation": "The best path is 2 -> 3. Adding -1 would only lower the sum."},
    {"input": "root = [-5, 4, 8, null, null, -2, 6]", "output": "14", "explanation": "The path 8 -> 6 sums to 14 and never touches the negative root; going through the root (4, -5, 8, 6) gives only 13."},
    {"input": "root = [-3]", "output": "-3", "explanation": "A path needs at least one node, so the only choice is the root itself."}
  ],
  "visibleTestCount": 3,
  "tests": [
    {"args": [[2, -1, 3]], "expected": 5},
    {"args": [[-5, 4, 8, null, null, -2, 6]], "expected": 14},
    {"args": [[-3]], "expected": -3},
    {"args": [[-2, -1, -3]], "expected": -1},
    {"args": [[1, 2, 3]], "expected": 6},
    {"args": [[0, 0, 0]], "expected": 0},
    {"args": [[1, -2, 3]], "expected": 4},
    {"args": [[-10, 2, -10, 20, 1, null, -25, null, null, null, null, 3, 4]], "expected": 23},
    {"args": [[3, -6, 9, 8, 2, -1, 5, null, null, null, -4, null, null, 7]], "expected": 26},
