  "compare": "exact",
  "adapters": {"node": "graph", "return": "graph_copy"},
  "referenceSolution": "def clone_graph(node: Optional[Node]) -> Optional[Node]:\n    if node is None:\n        return None\n    copies = {node: Node(node.val)}\n    stack = [node]\n    while stack:\n        current = stack.pop()\n        for neighbor in current.neighbors:\n            if neighbor not in copies:\n                copies[neighbor] = Node(neighbor.val)\n                stack.append(neighbor)\n            copies[current].neighbors.append(copies[neighbor])\n    return copies[node]\n",
  "targetComplexity": {"time": "O(V + E)", "space": "O(V)"},
