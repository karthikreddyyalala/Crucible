{
  "id": "code-counting-bits",
  "title": "Counting Bits",
  "difficulty": "easy",
  "topics": ["bit manipulation", "dynamic programming"],
  "asked": "common",
  "statement": "Given a non-negative integer `n`, return a list `ans` of length n + 1 where ans[i] is the number of 1 bits in the binary form of i, for every i from 0 to n.\n\nCounting the bits of each number separately works, but try to do it in a single pass by reusing answers you have already computed.\n\nConstraints: 0 <= n <= 10^5.",
  "functionName": "count_bits",
  "signature": "def count_bits(n: int) -> list[int]:",
  "starterCode": "def count_bits(n: int) -> list[int]:\n    \"\"\"Return the number of 1 bits of every integer from 0 to n, as a list of length n + 1.\"\"\"\n    pass\n",
  "examples": [
    {"input": "n = 2", "output": "[0, 1, 1]", "explanation": "0 is 0, 1 is 1 and 2 is 10 in binary, so the counts are 0, 1, 1."},
    {"input": "n = 5", "output": "[0, 1, 1, 2, 1, 2]", "explanation": "3 is 11 (two 1s), 4 is 100 (one) and 5 is 101 (two)."},
    {"input": "n = 0", "output": "[0]", "explanation": "Only the number 0 itself, which has no 1 bits."}
  ],
  "visibleTestCount": 3,
  "tests": [
    {"args":[2],"expected":[0,1,1]},
    {"args":[5],"expected":[0,1,1,2,1,2]},
    {"args":[0],"expected":[0]},
    {"args":[1],"expected":[0,1]},
    {"args":[3],"expected":[0,1,1,2]},
    {"args":[8],"expected":[0,1,1,2,1,2,2,3,1]},
    {"args":[15],"expected":[0,1,1,2,1,2,2,3,1,2,2,3,2,3,3,4]},
    {"args":[16],"expected":[0,1,1,2,1,2,2,3,1,2,2,3,2,3,3,4,1]},
