  "referenceSolution": "from collections import deque\n\n\ndef alien_order(words: List[str]) -> str:\n    after = {ch: set() for word in words for ch in word}\n    indegree = dict.fromkeys(after, 0)\n    for a, b in zip(words, words[1:]):\n        for x, y in zip(a, b):\n            if x != y:\n                if y not in after[x]:\n                    after[x].add(y)\n                    indegree[y] += 1\n                break\n        else:\n            if len(a) > len(b):\n                return \"\"\n    queue = deque(ch for ch, count in indegree.items() if count == 0)\n    order = []\n    while queue:\n        ch = queue.popleft()\n        order.append(ch)\n        for nxt in after[ch]:\n            indegree[nxt] -= 1\n            if indegree[nxt] == 0:\n                queue.append(nxt)\n    return \"\".join(order) if len(order) == len(after) else \"\"\n",
