{
  "id": "code-binary-tree-level-order-traversal",
  "title": "Binary Tree Level Order Traversal",
  "difficulty": "medium",
  "topics": ["tree", "breadth-first search"],
  "asked": "very_common",
  "statement": "You're given the root of a binary tree. Return its values level by level: a list whose first entry holds the root's value, the next holds the values one level down, and so on. Within a level, list the values from left to right.\n\nAn empty tree gives an empty list. Each node is a `TreeNode` with `val`, `left` and `right`; the class is already defined for you. In the examples, a tree is written in level order with `null` for a missing child.\n\nConstraints: 0 to 2000 nodes; -1000 <= val <= 1000.",
  "functionName": "level_order",
  "signature": "def level_order(root: Optional[TreeNode]) -> List[List[int]]:",
  "starterCode": "def level_order(root: Optional[TreeNode]) -> List[List[int]]:\n    \"\"\"Return the node values grouped by level, left to right.\"\"\"\n    pass\n",
  "examples": [
    {"input": "root = [1, 2, 3, 4, null, null, 5]", "output": "[[1], [2, 3], [4, 5]]", "explanation": "4 is the left child of 2 and 5 the right child of 3; they share the third level."},
    {"input": "root = [7]", "output": "[[7]]", "explanation": "A single node makes a single level."},
    {"input": "root = []", "output": "[]", "explanation": "No nodes, no levels."}
  ],
  "visibleTestCount": 3,
