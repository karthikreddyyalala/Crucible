  "compare": "exact",
  "checkArg": 0,
  "adapters": {"head": "linked_list"},
  "referenceSolution": "def reorder_list(head: Optional[ListNode]) -> None:\n    if not head or not head.next:\n        return\n    slow, fast = head, head\n    while fast.next and fast.next.next:\n        slow, fast = slow.next, fast.next.next\n    second = slow.next\n    slow.next = None\n    prev = None\n    while second:\n        nxt = second.next\n        second.next = prev\n        prev, second = second, nxt\n    first, second = head, prev\n    while second:\n        first_next, second_next = first.next, second.next\n        first.next = second\n        second.next = first_next\n        first, second = first_next, second_next\n",
  "targetComplexity": {"time": "O(n)", "space": "O(1)"},
  "hints": [
    "Write the target order for 1 through 6 and note where each node comes from. Which half of the list supplies the nodes at the even positions?",
    "Taking nodes from the back of a singly linked list is the hard part. Could the back half be made walkable from its own head?",
    "If the second half were reversed, you could walk both halves forward at the same time. How do you find where the second half starts without knowing the length?",
    "Cut the first half's last link when you split, or you will create a cycle. Decide which half keeps the extra node when the length is odd.",
    "Find the middle with slow and fast pointers, reverse the second half in place, then weave the two halves together one node at a time."
  ],
  "followUps": [
    "What are the time and space complexity of your solution?",
    "A simpler approach stores every node in an array and uses two indices. What does it cost, and when would you accept it?",
    "Where does the middle node land for even and odd lengths, and how did you check that off-by-one?",
    "How would this change if the list were doubly linked?"
  ],
  "idealAnswerPoints": [
    "Finds the middle with slow and fast pointers",
    "Reverses the second half in place and cuts the first half so no cycle remains",
    "Interleaves the two halves by relinking nodes, not copying values",
    "States O(n) time and O(1) extra space, and can compare it with the array-of-nodes approach"
  ],
  "weakAnswerSigns": [
    "Overwrites node values instead of relinking nodes",
    "Forgets to cut the first half, leaving a cycle or a repeated tail",
    "Gets the middle wrong for even or odd lengths, so the last node is duplicated or dropped",
    "Stores all nodes in an array and never mentions the O(n) space it costs"
  ],
  "rubric": {
    "correctness": "The list from head reads front, back, second, second-to-last for even, odd, one-node and empty lists, with no cycle.",
    "efficiency": "O(n) time with O(1) extra space; the array-of-nodes version is O(n) space and should be named as a trade-off.",
    "code_quality": "Three clearly separated steps (find middle, reverse, merge) with each node's next saved before it is changed.",
    "communication": "Walks through an even and an odd example by hand and says which half keeps the extra node."
  }
