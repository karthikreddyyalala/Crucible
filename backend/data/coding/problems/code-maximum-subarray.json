  "asked": "very_common",
  "statement": "Given a list of integers `nums`, find the contiguous, non-empty run of elements with the largest sum and return that sum.\n\nThe list can contain negative numbers, and it can be made up of negative numbers only; in that case the answer is the single largest (least negative) element.\n\nConstraints: 1 <= len(nums) <= 10^5; -10^4 <= nums[i] <= 10^4.",
  "functionName": "max_sub_array",
  "signature": "def max_sub_array(nums: list[int]) -> int:",
  "starterCode": "def max_sub_array(nums: list[int]) -> int:\n    \"\"\"Return the largest sum of any contiguous, non-empty slice of nums.\"\"\"\n    pass\n",
  "examples": [
    {"input": "nums = [3, -4, 5, -1, 6, -8]", "output": "10", "explanation": "The best slice is [5, -1, 6], which sums to 10; extending it to include -8 or -4 only lowers it."},
    {"input": "nums = [-7, -2, -9]", "output": "-2", "explanation": "Every number is negative, so the best slice is the single largest element, -2."},
    {"input": "nums = [4]", "output": "4", "explanation": "A one-element list: the only slice is the list itself."}
  ],
