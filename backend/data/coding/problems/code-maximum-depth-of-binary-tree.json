{
  "id": "code-maximum-depth-of-binary-tree",
  "title": "Maximum Depth of Binary Tree",
  "difficulty": "easy",
  "topics": ["tree", "depth-first search", "breadth-first search"],
  "asked": "very_common",
  "statement": "You're given the root of a binary tree. Return its maximum depth: the number of nodes on the longest path that starts at the root and ends at a leaf.\n\nAn empty tree (`root` is `None`) has depth 0. Each node is a `TreeNode` with `val`, `left` and `right`; the class is already defined for you. In the examples, a tree is written in level order with `null` for a missing child.\n\nConstraints: 0 to 10^4 nodes; -100 <= val <= 100.",
  "functionName": "max_depth",
  "signature": "def max_depth(root: Optional[TreeNode]) -> int:",
  "starterCode": "def max_depth(root: Optional[TreeNode]) -> int:\n    \"\"\"Return the number of nodes on the longest root-to-leaf path.\"\"\"\n    pass\n",
  "examples": [
    {"input": "root = [1, 2, 3, 4, null, null, null, 5]", "output": "4", "explanation": "The longest path is 1 -> 2 -> 4 -> 5, which has four nodes."},
    {"input": "root = [8, null, 6]", "output": "2", "explanation": "8 has only a right child, so the longest path is 8 -> 6."},
    {"input": "root = []", "output": "0", "explanation": "An empty tree has no nodes, so its depth is 0."}
  ],
  "visibleTestCount": 3,
