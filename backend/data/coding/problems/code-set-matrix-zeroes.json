  "checkArg": 0,
  "referenceSolution": "def set_zeroes(matrix: List[List[int]]) -> None:\n    rows, cols = len(matrix), len(matrix[0])\n    first_row_zero = any(v == 0 for v in matrix[0])\n    first_col_zero = any(matrix[i][0] == 0 for i in range(rows))\n    for i in range(1, rows):\n        for j in range(1, cols):\n            if matrix[i][j] == 0:\n                matrix[i][0] = matrix[0][j] = 0\n    for i in range(1, rows):\n        for j in range(1, cols):\n            if matrix[i][0] == 0 or matrix[0][j] == 0:\n                matrix[i][j] = 0\n    if first_row_zero:\n        for j in range(cols):\n            matrix[0][j] = 0\n    if first_col_zero:\n        for i in range(rows):\n            matrix[i][0] = 0\n",
  "targetComplexity": {"time": "O(m * n)", "space": "O(1)"},
  "hints": [
    "Look at one zero in the middle of the grid. Which cells must change because of it, and which must not?",
