{
  "id": "code-maximum-product-subarray",
  "title": "Maximum Product Subarray",
  "difficulty": "medium",
  "topics": ["array", "dynamic programming"],
  "asked": "common",
  "statement": "Given a list of integers `nums`, find the contiguous, non-empty run of elements whose product is as large as possible, and return that product.\n\nThe list may contain negative numbers and zeros, so the best run is not always the whole list. A run of one element counts.\n\nConstraints: 1 <= len(nums) <= 2 * 10^4; -10 <= nums[i] <= 10; the answer fits in a 32-bit signed integer.",
  "functionName": "max_product",
  "signature": "def max_product(nums: list[int]) -> int:",
  "starterCode": "def max_product(nums: list[int]) -> int:\n    \"\"\"Return the largest product of any contiguous, non-empty slice of nums.\"\"\"\n    pass\n",
  "examples": [
    {"input": "nums = [1, -2, 3, -1, 2]", "output": "12", "explanation": "Two negatives cancel: the whole list gives 1 * -2 * 3 * -1 * 2 = 12."},
    {"input": "nums = [-3, 0, -2]", "output": "0", "explanation": "Any slice containing the zero has product 0, and the single values -3 and -2 are negative, so the best product is 0."},
    {"input": "nums = [-4]", "output": "-4", "explanation": "With one element the only slice is that element, so the answer is -4."}
  ],
  "visibleTestCount": 3,
