  "compare": "exact",
  "referenceSolution": "def max_profit(prices: list[int]) -> int:\n    lowest, best = prices[0], 0\n    for price in prices:\n        lowest = min(lowest, price)\n        best = max(best, price - lowest)\n    return best\n",
  "targetComplexity": {"time": "O(n)", "space": "O(1)"},
  "hints": [
    "Fix the day you sell on. What would you most like to know about the days before it?",
    "Trying every buy/sell pair works but re-reads the same earlier prices again and again. Is there one number from the past that is enough?",
    "What should you return when prices only ever fall, and how will your code produce that without a special case?",
    "Trace [6, 8, 7, 1, 3]. Why is 'highest price minus lowest price' the wrong answer here?",
    "One left-to-right pass: keep the lowest price seen so far and the best profit so far, and update both each day."
  ],
  "followUps": [
    "What are the time and space complexity, and is there any way to do better on either?",
    "Why does subtracting the overall minimum from the overall maximum fail, and what order constraint does the right solution respect?",
    "How would you also return the buy day and the sell day?",
    "If you could buy and sell as many times as you like, holding one share at a time, how would the answer change?"
  ],
  "idealAnswerPoints": [
    "Reframes the problem as: for each sell day, the best buy day is the cheapest day before it",
    "Tracks a running minimum price and a running best profit in a single pass",
    "Returns 0 naturally when prices only fall instead of adding a special case",
    "States O(n) time and O(1) space, and mentions the O(n^2) pair check as the starting point"
  ],
  "weakAnswerSigns": [
    "Checks every pair of days with nested loops and never improves on it",
    "Takes max(prices) - min(prices) without checking that the minimum comes first",
    "Returns a negative number when prices fall, or crashes on a single-day list"
  ],
  "rubric": {
    "correctness": "Right answer when prices fall, rise, stay flat, have a single day, or put the low point after the high point.",
    "efficiency": "One pass, O(n) time and O(1) space. A quadratic pair check only counts if the candidate names it and moves past it.",
    "code_quality": "A running minimum and running best with clear names; no sorting, no copied lists, no dead branches.",
    "communication": "States the buy-before-sell constraint, explains why the running minimum is enough, and traces one example."
  }
}
