{
  "id": "code-top-k-frequent-elements",
  "title": "Top K Frequent Elements",
  "difficulty": "medium",
  "topics": ["array", "hash map", "heap", "bucket sort"],
  "asked": "very_common",
  "statement": "You're given a list of integers `nums` and an integer `k`. Return the `k` values that appear most often in `nums`, in any order.\n\nEach test is built so the answer is unambiguous: there is never a tie for the k-th place that would leave a choice of which value to return. Aim for better than O(n log n) time.\n\nConstraints: 1 <= len(nums) <= 100,000; -10,000 <= nums[i] <= 10,000; 1 <= k <= the number of distinct values in nums.",
  "kind": "function",
  "functionName": "top_k_frequent",
  "signature": "def top_k_frequent(nums: List[int], k: int) -> List[int]:",
  "starterCode": "def top_k_frequent(nums: List[int], k: int) -> List[int]:\n    \"\"\"Return the k most frequent values in nums, in any order.\"\"\"\n    pass\n",
  "starterCodeJs": "/**\n * Return the k most frequent values in nums, in any order.\n * @param {number[]} nums\n * @param {number} k\n * @return {number[]}\n */\nfunction topKFrequent(nums, k) {\n\n}\n",
  "examples": [
    {"input": "nums = [4, 4, 4, 7, 7, 9, 9, 9, 9, 2], k = 2", "output": "[9, 4]", "explanation": "9 appears 4 times and 4 appears 3 times; 7 and 2 appear less often. The order of the answer does not matter."},
    {"input": "nums = [3], k = 1", "output": "[3]", "explanation": "A single value is the most frequent."},
    {"input": "nums = [10, 20, 30], k = 3", "output": "[10, 20, 30]", "explanation": "When k equals the number of distinct values, every value is returned."}
  ],
