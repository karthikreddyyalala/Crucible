  "referenceSolution": "def is_valid_bst(root: Optional[TreeNode]) -> bool:\n    stack, prev, node = [], None, root\n    while stack or node:\n        while node:\n            stack.append(node)\n            node = node.left\n        node = stack.pop()\n        if prev is not None and node.val <= prev:\n            return False\n        prev, node = node.val, node.right\n    return True\n",
