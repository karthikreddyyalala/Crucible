{
  "id": "code-container-with-most-water",
  "title": "Container With Most Water",
  "difficulty": "medium",
  "topics": ["array", "two pointers", "greedy"],
  "asked": "very_common",
  "statement": "You're given a list `height` where `height[i]` is the height of a vertical wall standing at position `i` on a number line. Choose any two walls; together with the ground they form a container, and the water it holds is the distance between the two walls times the height of the shorter one. Walls can't be tilted, and the walls in between are ignored.\n\nReturn the largest amount of water any pair of walls can hold.\n\nConstraints: 2 <= len(height) <= 10^5; 0 <= height[i] <= 10^4.",
  "functionName": "max_area",
  "signature": "def max_area(height: list[int]) -> int:",
  "starterCode": "def max_area(height: list[int]) -> int:\n    \"\"\"Return the largest amount of water held between any two walls, where area = distance * the shorter wall's height.\"\"\"\n    pass\n",
  "starterCodeJs": "/**\n * Return the largest amount of water held between any two walls, where area = distance * the shorter wall's height.\n * @param {number[]} height\n * @return {number}\n */\nfunction maxArea(height) {\n\n}\n",
  "examples": [
    {"input": "height = [3, 9, 4, 7, 2, 8]", "output": "32", "explanation": "The walls of height 9 (position 1) and 8 (position 5) are 4 apart and the shorter is 8: 4 * 8 = 32."},
    {"input": "height = [5, 5]", "output": "5", "explanation": "Two walls of height 5 that are 1 apart hold 1 * 5 = 5."},
    {"input": "height = [6, 1, 1, 1, 1, 6]", "output": "30", "explanation": "The two walls of height 6 are 5 apart: 5 * 6 = 30. The short walls between them do not matter."}
  ],
