  "compare": "unordered",
  "referenceSolution": "def find_words(board: List[List[str]], words: List[str]) -> List[str]:\n    root = {}\n    for word in words:\n        node = root\n        for ch in word:\n            node = node.setdefault(ch, {})\n        node[\"$\"] = word\n    rows, cols, found = len(board), len(board[0]), []\n\n    def walk(r, c, parent):\n        ch = board[r][c]\n        node = parent[ch]\n        word = node.pop(\"$\", None)\n        if word is not None:\n            found.append(word)\n        board[r][c] = \"#\"\n        for nr, nc in ((r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)):\n            if 0 <= nr < rows and 0 <= nc < cols and board[nr][nc] in node:\n                walk(nr, nc, node)\n        board[r][c] = ch\n        if not node:\n            parent.pop(ch)\n\n    for r in range(rows):\n        for c in range(cols):\n            if board[r][c] in root:\n                walk(r, c, root)\n    return found\n",
