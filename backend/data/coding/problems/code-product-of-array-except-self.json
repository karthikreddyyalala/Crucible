{
  "id": "code-product-of-array-except-self",
  "title": "Product of Array Except Self",
  "difficulty": "medium",
  "topics": ["array", "prefix sum"],
  "asked": "very_common",
  "statement": "Given a list of integers `nums`, return a new list `answer` of the same length where `answer[i]` is the product of every element of `nums` except `nums[i]`.\n\nDo not use division, and aim for a solution that runs in O(n) time. The list may contain zeros and negative numbers.\n\nConstraints: 2 <= len(nums) <= 10^5; -30 <= nums[i] <= 30; every product fits in a 32-bit signed integer.",
  "functionName": "product_except_self",
  "signature": "def product_except_self(nums: list[int]) -> list[int]:",
  "starterCode": "def product_except_self(nums: list[int]) -> list[int]:\n    \"\"\"Return a list where each entry is the product of all other elements of nums, without using division.\"\"\"\n    pass\n",
  "starterCodeJs": "/**\n * Return a list where each entry is the product of all other elements of nums, without using division.\n * @param {number[]} nums\n * @return {number[]}\n */\nfunction productExceptSelf(nums) {\n\n}\n",
  "examples": [
    {"input": "nums = [2, 3, 4, 5]", "output": "[60, 40, 30, 24]", "explanation": "For index 0: 3 * 4 * 5 = 60; index 1: 2 * 4 * 5 = 40; and so on."},
    {"input": "nums = [1, 0, 3]", "output": "[0, 3, 0]", "explanation": "The zero at index 1 wipes out every product that includes it, so only index 1 itself is non-zero: 1 * 3 = 3."},
    {"input": "nums = [-1, 2, -3]", "output": "[-6, 3, -2]", "explanation": "Two negatives and one positive: -6 is (2 * -3), 3 is (-1 * -3) and -2 is (-1 * 2)."}
  ],
  "visibleTestCount": 3,
