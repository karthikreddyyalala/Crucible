{
  "id": "code-pacific-atlantic-water-flow",
  "title": "Pacific Atlantic Water Flow",
  "difficulty": "medium",
  "topics": ["graph", "breadth-first search", "matrix"],
  "asked": "common",
  "statement": "`heights` is a grid of non-negative integers giving the height of each cell. The Pacific Ocean touches the top row and the left column; the Atlantic Ocean touches the bottom row and the right column. Water on a cell flows to any neighbour (up, down, left or right) whose height is less than or equal to its own, and water on a border cell drains straight into the ocean that border touches.\n\nReturn every cell [row, column] from which water can reach both oceans, as a list of [row, column] pairs in any order.\n\nConstraints: 1 <= rows, columns <= 100; 0 <= heights[r][c] <= 10^5.",
  "functionName": "pacific_atlantic",
  "signature": "def pacific_atlantic(heights: list[list[int]]) -> list[list[int]]:",
  "starterCode": "def pacific_atlantic(heights: list[list[int]]) -> list[list[int]]:\n    \"\"\"Return all [row, col] cells whose water can flow to both the Pacific and the Atlantic.\"\"\"\n    pass\n",
  "starterCodeJs": "/**\n * Return all [row, col] cells whose water can flow to both the Pacific and the Atlantic.\n * @param {number[][]} heights\n * @return {number[][]}\n */\nfunction pacificAtlantic(heights) {\n\n}\n",
  "examples": [
    {"input": "heights = [[1, 2], [2, 1]]", "output": "[[0, 1], [1, 0]]", "explanation": "[0, 1] touches the Pacific (top) and the Atlantic (right edge). [1, 0] touches the Pacific (left) and the Atlantic (bottom). Each cell of height 1 is boxed in by higher neighbours and reaches only one ocean."},
    {"input": "heights = [[5, 4, 3], [4, 3, 2], [3, 2, 1]]", "output": "[[0, 0], [0, 1], [0, 2], [1, 0], [2, 0]]", "explanation": "Everything slopes down toward the bottom right. The top row and left column touch the Pacific and can still run downhill to the Atlantic; the other cells can never climb back to the Pacific."},
    {"input": "heights = [[7]]", "output": "[[0, 0]]", "explanation": "The only cell touches both oceans."}
  ],
